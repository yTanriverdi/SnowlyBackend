# 1️⃣ Build aşaması
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Tüm repo kökünü kopyala
COPY . .

# Restore solution üzerinden
RUN dotnet restore Snowly.sln

# Publish API projesi
RUN dotnet publish src/Snowly.API/Snowly.API.csproj -c Release -o /app/out

# 2️⃣ Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out .

ENV ASPNETCORE_URLS=http://*:${PORT}
EXPOSE ${PORT}

ENTRYPOINT ["dotnet", "Snowly.API.dll"]


