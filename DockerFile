# 1️⃣ Build aşaması
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Tüm solution klasörünü kopyala (solution + projeler)
COPY . .

# Restore
RUN dotnet restore Snowly/Snowly.csproj

# Publish
RUN dotnet publish Snowly/Snowly.csproj -c Release -o /app/out

# 2️⃣ Runtime aşaması
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out .

ENV ASPNETCORE_URLS=http://*:${PORT}
EXPOSE ${PORT}

ENTRYPOINT ["dotnet", "Snowly.dll"]

