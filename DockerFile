# 1️⃣ Build aşaması
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Repo kökünü container içine kopyala
COPY . .

# Restore tüm solution üzerinden
RUN dotnet restore Snowly.sln

# Publish API projesi
RUN dotnet publish Snowly.WebAPI/Snowly.WebAPI.csproj -c Release -o /app/out

# 2️⃣ Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# Publish edilen dosyaları kopyala
COPY --from=build /app/out .


ENV ASPNETCORE_URLS=http://*:${PORT}
EXPOSE ${PORT}

ENTRYPOINT ["dotnet", "Snowly.WebAPI.dll"]





